# Brillo Events Santa Operations Hub - Environment Variables
DATABASE_URL="file:./dev.db"
NODE_ENV="development"
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Company Information (Verify contact details with owner before live launch)
COMPANY_NAME="Brillo Events Management Service"
COMPANY_PHONE="0927 887 2343"
COMPANY_EMAIL="brilloevents@gmail.com"

# Shared Mailbox & Automated Email Adapter
# Options: 'smtp' | 'mock' | 'disabled'
EMAIL_PROVIDER="mock"
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT="587"
EMAIL_USER=""
EMAIL_PASS=""
EMAIL_FROM="Brillo Events <brilloevents@gmail.com>"

# E-Signature Integration Adapter
# Options: 'manual' | 'documenso' | 'docusign'
ESIGN_PROVIDER="manual"
ESIGN_API_KEY=""
ESIGN_WEBHOOK_SECRET=""

# Security & Session
AUTH_SECRET="brillo-santa-hub-dev-secret-key-2026-secure"
